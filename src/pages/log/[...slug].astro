---
/**
 * Log detail — generated only for logs that have a body, so a blurb-only
 * log stays a terminal card and never produces a dead page.
 */
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import KindBadge from '@/components/KindBadge.astro';
import TagChip from '@/components/TagChip.astro';
import { getLogs, logCode, logHasBody, categoryHref, type Log } from '@/lib/content';
import { categoryBySlug } from '@/data/categories';
import { resolveTexture } from '@/lib/patterns';
import { resolvePeriod } from '@/lib/periods';
import { orientation } from '@/lib/images';
import { isoDay } from '@/lib/format';

export async function getStaticPaths() {
  const logs = (await getLogs()).filter(logHasBody);
  return logs.map((log) => ({ params: { slug: log.id }, props: { log } }));
}

interface Props {
  log: Log;
}

const { log } = Astro.props;
const { Content } = await render(log);
const code = await logCode(log);
const category = categoryBySlug(log.data.category);
const period = resolvePeriod(log.data.date);
const ogImage = log.data.image
  ? new URL((await getImage({ src: log.data.image, width: 1200 })).src, Astro.site).toString()
  : undefined;
const texture = resolveTexture(category ?? { slug: log.data.category });
---

<Base
  title={log.data.title}
  description={log.data.summary}
  ogImage={ogImage}
  ogType="article"
  pattern={texture.pattern}
  hue={texture.hue}
>
  <article class="wrap max-w-3xl py-10" data-pagefind-body>
    <span class="sr-only" data-pagefind-filter="type">Log</span>
    <span class="sr-only" data-pagefind-filter="kind">{log.data.kind}</span>
    <header>
      <p class="kicker">
        Log · {code}
        {log.data.draft && <span class="text-signal-text"> · draft</span>}
      </p>
      <h1 class="mt-2 font-display text-3xl leading-tight sm:text-4xl">{log.data.title}</h1>
      <p class="rail mt-4 flex flex-wrap items-center gap-x-3 gap-y-1.5">
        <span>{isoDay(log.data.date)}</span>
        <KindBadge kind={log.data.kind} />
        <a href={`/monthly/#period-${period.id}`} class="hover:text-accent">{period.label}</a>
        {
          category && (
            <a
              href={categoryHref(category.slug)}
              class="hover:text-accent"
              data-pagefind-filter="category"
            >
              {category.label}
            </a>
          )
        }
      </p>
      {log.data.summary && <p class="mt-4 text-lg leading-relaxed text-muted">{log.data.summary}</p>}
    </header>

    {
      log.data.image && (
        <figure class="frame mt-8 overflow-hidden">
          <Image
            src={log.data.image}
            alt={`${log.data.title} — photo`}
            widths={[720, 1100]}
            sizes="(min-width: 768px) 48rem, 94vw"
            class:list={
              orientation(log.data.image) === 'wide' ? 'w-full' : 'mx-auto w-auto max-h-[70vh]'
            }
            loading="eager"
          />
        </figure>
      )
    }

    <div class="prose-reflection mt-8">
      <Content />
    </div>

    <footer class="mt-10 flex flex-wrap items-center gap-2 border-t border-line pt-6">
      {log.data.tags.map((tag) => <TagChip tag={tag} />)}
      {
        log.data.link && (
          <a
            href={log.data.link}
            target="_blank"
            rel="noopener"
            class="rail transition-colors hover:text-accent"
          >
            External link ↗
          </a>
        )
      }
    </footer>
  </article>
</Base>
