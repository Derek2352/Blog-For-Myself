---
import Base from '@/layouts/Base.astro';
import EntryCard from '@/components/EntryCard.astro';
import LogCard from '@/components/LogCard.astro';
import { getEntries, getLogs, allTags, toFeed } from '@/lib/content';

export async function getStaticPaths() {
  const tags = await allTags();
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const entries = (await getEntries()).filter((e) => e.data.tags.includes(tag));
const logs = (await getLogs()).filter((l) => l.data.tags.includes(tag));
const items = toFeed(entries, logs);
---

<Base
  title={`#${tag}`}
  description={`Entries and logs tagged “${tag}”.`}
  hue={26}
>
  <div class="wrap py-10">
    <header>
      <p class="kicker">tag</p>
      <h1 class="mt-2 font-display text-4xl sm:text-5xl">#{tag}</h1>
      <p class="rail mt-3">
        {items.length}
        {items.length === 1 ? 'item' : 'items'} · <a href="/tags/">all tags</a>
      </p>
    </header>
    <h2 class="sr-only">Tagged items</h2>
    <div class="mt-8 grid max-w-3xl grid-cols-1 gap-3">
      {
        items.map((item) =>
          item.type === 'entry' ? (
            <EntryCard entry={item.entry} compact showCategory />
          ) : (
            <LogCard log={item.log} showCategory />
          ),
        )
      }
    </div>
  </div>
</Base>
