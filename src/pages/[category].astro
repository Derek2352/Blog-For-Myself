---
/**
 * Category page — routes are generated from src/data/categories.ts alone.
 * Adding a category object there creates this page; nothing here is
 * category-specific. Two sections: the entries grid, then that category's
 * monthly log grouped period → month.
 */
import Base from '@/layouts/Base.astro';
import EntryCard from '@/components/EntryCard.astro';
import PeriodGroup from '@/components/PeriodGroup.astro';
import { categories, RESERVED_SLUGS, type Category } from '@/data/categories';
import { getEntries, getLogs, sortForCategory, toFeed, groupByPeriod } from '@/lib/content';
import { resolveWash } from '@/lib/wash';

export async function getStaticPaths() {
  for (const c of categories) {
    if ((RESERVED_SLUGS as readonly string[]).includes(c.slug)) {
      throw new Error(
        `Category slug "${c.slug}" collides with a fixed route. Rename it in src/data/categories.ts (reserved: ${RESERVED_SLUGS.join(', ')}).`,
      );
    }
  }
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const entries = sortForCategory(
  (await getEntries()).filter((e) => e.data.category === category.slug),
);
const logs = (await getLogs()).filter((l) => l.data.category === category.slug);
const logGroups = groupByPeriod(toFeed([], logs));
const wash = resolveWash(category);
---

<Base
  title={category.label}
  description={category.blurb || undefined}
  ogImage={new URL(`/og/category/${category.slug}.png`, Astro.site).toString()}
  hue={wash.hue}
  tab={category.slug}
>
  <div class="wrap py-10">
    <header class="max-w-3xl">
      <p class="kicker">Index / {category.slug}</p>
      <h1 class="mt-2 font-display text-4xl sm:text-5xl">{category.label}</h1>
      {category.blurb && <p class="mt-3 text-lg leading-relaxed text-muted">{category.blurb}</p>}
      <p class="rail mt-4">
        {entries.length} {entries.length === 1 ? 'entry' : 'entries'} · {logs.length}
        {logs.length === 1 ? ' log' : ' logs'}
      </p>
    </header>

    <section class="mt-10" aria-labelledby="entries-h">
      <h2 id="entries-h" class="sr-only">Entries</h2>
      {
        entries.length > 0 ? (
          <div class="grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" data-io-stagger>
            {entries.map((entry) => (
              <EntryCard entry={entry} />
            ))}
          </div>
        ) : (
          /* Visitor-facing: this page is reachable by URL, sitemap and search,
             so the author-only hint stays behind the DEV flag (same pattern as
             PhotoPlan.astro). */
          <div class="max-w-prose">
            <p class="font-display text-2xl italic leading-snug">Nothing here yet.</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              This part of the site is still being filled in. The{' '}
              <a href="/timeline/" class="text-accent hover:underline">
                timeline
              </a>{' '}
              has everything published so far.
            </p>
            {import.meta.env.DEV && (
              <p class="rail mt-4 text-signal-text">
                dev note: npm run new-entry starts one here
              </p>
            )}
          </div>
        )
      }
    </section>

    <section class="mt-20" aria-labelledby="monthly-log-h">
      <p class="kicker">Monthly log</p>
      <h2 id="monthly-log-h" class="mt-1 font-display text-3xl">Small things, monthly</h2>
      {
        logGroups.length > 0 ? (
          <div class="mt-8 space-y-12">
            {logGroups.map((group) => (
              <PeriodGroup group={group} headingLevel="h3" />
            ))}
          </div>
        ) : (
          <>
            <p class="mt-4 text-sm leading-relaxed text-muted">
              No monthly notes filed under this one yet.
            </p>
            {import.meta.env.DEV && (
              <p class="rail mt-3 text-signal-text">dev note: npm run new-log adds one</p>
            )}
          </>
        )
      }
    </section>
  </div>
</Base>
