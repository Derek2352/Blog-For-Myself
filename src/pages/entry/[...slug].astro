---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import MetadataRail from '@/components/MetadataRail.astro';
import Gallery from '@/components/Gallery.astro';
import EntryCard from '@/components/EntryCard.astro';
import PhotoPlan from '@/components/PhotoPlan.astro';
import VideoEmbed from '@/components/VideoEmbed.astro';
import {
  getEntries,
  entryCode,
  relatedEntries,
  categoryHref,
  entryHref,
  sortForCategory,
  reflectionWritten,
  type Entry,
} from '@/lib/content';
import { categoryBySlug } from '@/data/categories';
import { resolveTexture } from '@/lib/patterns';
import { orientation } from '@/lib/images';

export async function getStaticPaths() {
  const entries = await getEntries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const hasReflection = reflectionWritten(entry);
const code = await entryCode(entry);
const category = categoryBySlug(entry.data.category);
const related = await relatedEntries(entry);
const ogImage = new URL(`/og/${entry.id}.png`, Astro.site).toString();
const texture = resolveTexture(category ?? { slug: entry.data.category });

// prev/next within this category, same order as the category grid
const siblings = sortForCategory(
  (await getEntries()).filter((e) => e.data.category === entry.data.category),
);
const index = siblings.findIndex((e) => e.id === entry.id);
const prev = index > 0 ? siblings[index - 1] : undefined;
const next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined;
const prevCode = prev ? await entryCode(prev) : '';
const nextCode = next ? await entryCode(next) : '';
---

<Base
  title={entry.data.title}
  description={entry.data.summary}
  ogImage={ogImage}
  ogType="article"
  pattern={texture.pattern}
  hue={texture.hue}
>
  <article class="wrap py-10" data-pagefind-body>
    <header class="max-w-3xl">
      <p class="kicker">
        {
          category && (
            <a href={categoryHref(category.slug)} class="hover:underline">
              {category.label}
            </a>
          )
        }
        {' · '}{code}
        {entry.data.draft && <span class="text-signal-text"> · draft</span>}
      </p>
      <h1 class="mt-2 font-display text-4xl leading-[1.08] sm:text-5xl">{entry.data.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">{entry.data.summary}</p>
      {
        entry.data.note && (
          <p class="mt-4 font-display text-xl italic leading-snug">
            <span class="text-signal-text" aria-hidden="true">
              ~{' '}
            </span>
            {entry.data.note}
          </p>
        )
      }
    </header>
    <PhotoPlan entry={entry} />

    {
      entry.data.video ? (
        <div class="mt-8" transition:name={`cover-${entry.id}`}>
          <VideoEmbed url={entry.data.video} title={entry.data.title} poster={entry.data.cover} />
        </div>
      ) : (
        <figure class="frame mt-8 overflow-hidden" transition:name={`cover-${entry.id}`}>
          {/* wide covers run full width; tall/square ones hang matted at a capped height */}
          <Image
            src={entry.data.cover}
            alt={`${entry.data.title} — cover image`}
            widths={[720, 1100, 1600]}
            sizes="(min-width: 1280px) 72rem, 94vw"
            class:list={
              orientation(entry.data.cover) === 'wide'
                ? 'w-full'
                : 'mx-auto w-auto max-h-[75vh]'
            }
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="mt-10 grid gap-10 lg:grid-cols-[16rem_1fr] lg:gap-14">
      <MetadataRail entry={entry} />
      {
        hasReflection ? (
          <div class="prose-reflection min-w-0">
            <Content />
          </div>
        ) : (
          <div class="min-w-0 self-start border-t border-line pt-6">
            <p class="font-display text-2xl italic leading-snug">
              The full reflection is still being written.
            </p>
            <p class="mt-3 max-w-prose text-sm leading-relaxed text-muted">
              Every entry here ends the same way — what it was, what I did, what I learned,
              and how it felt. This one's words are coming; the rail alongside has the facts
              meanwhile.
            </p>
            {import.meta.env.DEV && (
              <p class="rail mt-4 text-signal-text">
                dev note: write the four sections in this entry's index.md and this
                placeholder disappears
              </p>
            )}
          </div>
        )
      }
    </div>

    {
      entry.data.gallery.length > 0 && (
        <section class="mt-16" aria-labelledby="gallery-h">
          <p class="kicker">Gallery</p>
          <h2 id="gallery-h" class="mt-1 font-display text-2xl">
            Frames
          </h2>
          <div class="mt-5">
            <Gallery images={entry.data.gallery} id={entry.id} />
          </div>
        </section>
      )
    }

    {
      (prev || next) && (
        <nav
          class="mt-16 grid gap-3 sm:grid-cols-2"
          aria-label={`More in ${category?.label ?? entry.data.category}`}
          data-pagefind-ignore
        >
          {prev ? (
            <a
              href={entryHref(prev)}
              data-plane="prev"
              class="panel group block p-4 transition-colors hover:border-accent"
            >
              <p class="rail">← previous · {prevCode}</p>
              <p class="mt-1 font-display text-lg leading-snug transition-colors group-hover:text-accent">
                {prev.data.title}
              </p>
            </a>
          ) : (
            <span class="hidden sm:block" />
          )}
          {next && (
            <a
              href={entryHref(next)}
              data-plane="next"
              class="panel group block p-4 text-right transition-colors hover:border-accent"
            >
              <p class="rail">{nextCode} · next →</p>
              <p class="mt-1 font-display text-lg leading-snug transition-colors group-hover:text-accent">
                {next.data.title}
              </p>
            </a>
          )}
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section
          class="mt-16 border-t border-line pt-10"
          aria-labelledby="related-h"
          data-pagefind-ignore
        >
          <p class="kicker">Related</p>
          <h2 id="related-h" class="mt-1 font-display text-2xl">
            Nearby frames
          </h2>
          <div class="mt-6 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <EntryCard entry={r} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</Base>

<script>
  // The paper plane: prev/next launches a little plane that arcs off in the
  // direction of travel, then the next page glides in. Reduced-motion (or
  // modified clicks) fall through to plain navigation.
  import { navigate } from 'astro:transitions/client';

  const PLANE_SVG =
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M3.4 20.4 21.5 12 3.4 3.6l-.01 6.6L16 12 3.39 13.8z"/></svg>';

  function fly(link: HTMLAnchorElement, dir: 1 | -1): void {
    const rect = link.getBoundingClientRect();
    const plane = document.createElement('span');
    plane.className = 'paper-plane';
    plane.innerHTML = PLANE_SVG;
    plane.style.left = `${rect.left + rect.width / 2}px`;
    plane.style.top = `${rect.top + rect.height / 2}px`;
    const svg = plane.querySelector('svg');
    if (dir === -1 && svg) svg.style.transform = 'scaleX(-1)';
    document.body.appendChild(plane);

    const dx = dir * window.innerWidth * 0.55;
    const flight = plane.animate(
      [
        { transform: 'translate(0, 0) rotate(0deg)', opacity: 1 },
        {
          transform: `translate(${dx * 0.6}px, -46px) rotate(${dir * -10}deg)`,
          opacity: 1,
          offset: 0.65,
        },
        {
          transform: `translate(${dx}px, -84px) rotate(${dir * -16}deg) scale(0.8)`,
          opacity: 0,
        },
      ],
      { duration: 600, easing: 'cubic-bezier(0.3, 0.1, 0.3, 1)' },
    );
    flight.finished
      .catch(() => {})
      .finally(() => {
        plane.remove();
        navigate(link.href);
      });
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLAnchorElement>('a[data-plane]').forEach((link) => {
      link.addEventListener('click', (e) => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        fly(link, link.dataset.plane === 'prev' ? -1 : 1);
      });
    });
  });
</script>
