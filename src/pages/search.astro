---
/**
 * /search — client-side full-text search over entries and logs, powered by
 * Pagefind. The index is generated after `astro build` (see the build
 * script), so in `npm run dev` this page shows a friendly fallback instead.
 */
import Base from '@/layouts/Base.astro';
---

<Base
  title="Search"
  description="Search every entry and log on this site."
  hue={45}
>
  <div class="wrap max-w-3xl py-10">
    <header>
      <p class="kicker">search</p>
      <h1 class="mt-2 font-display text-4xl sm:text-5xl">Find it again</h1>
      <p class="mt-3 text-muted">
        Every entry and log, searchable — competitions, trips, tools, places.
      </p>
    </header>

    <div id="search" class="mt-8"></div>

    {/* Without JavaScript, none of the below can run — including the very script that
        unhides the fallback underneath. Measured: this page rendered a heading, the promise
        "every entry and log, searchable", and then an empty void, because the only route to
        the apology was the route that was broken. A `<noscript>` is the one message that
        cannot depend on the thing that failed. Both destinations here are static pages that
        work perfectly well without scripting. */}
    <noscript>
      <p class="mt-8 text-muted">
        Search needs JavaScript — it reads an index in your browser rather than on a server.
        Everything is still reachable without it: the{' '}
        <a href="/timeline/" class="text-accent underline">timeline</a> lists every entry and log
        in one line, and <a href="/tags/" class="text-accent underline">tags</a> group them by
        subject.
      </p>
    </noscript>

    {/* This fallback unhides whenever the index fails to load — in dev that
        means "not built yet", but on the deployed site it means something
        actually broke, and a visitor shouldn't be handed shell commands. */}
    <p id="search-fallback" class="mt-8 text-muted" hidden>
      {
        import.meta.env.DEV ? (
          <>
            Search is generated at build time — run{' '}
            <code class="font-mono text-sm">npm run build</code> &amp;{' '}
            <code class="font-mono text-sm">npm run preview</code> to try it locally.
          </>
        ) : (
          <>
            Search isn’t loading right now. The{' '}
            <a href="/timeline/" class="text-accent hover:underline">
              timeline
            </a>{' '}
            lists everything in one place, and{' '}
            <a href="/tags/" class="text-accent hover:underline">
              tags
            </a>{' '}
            group it by subject.
          </>
        )
      }
    </p>
  </div>
</Base>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline data-astro-rerun>
  (async () => {
    try {
      await import('/pagefind/pagefind-ui.js');
      new window.PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        autofocus: true,
      });
      // Pagefind labels its box with a placeholder only, which disappears once
      // you type. Add a persistent accessible name and keep it applied across
      // Pagefind's re-renders (WCAG 3.3.2 Labels or Instructions / 4.1.2).
      const nameInput = () => {
        const inp = document.querySelector('#search input[type="text"]');
        if (inp && inp.getAttribute('aria-label') !== 'Search entries and logs') {
          inp.setAttribute('aria-label', 'Search entries and logs');
        }
      };
      const searchEl = document.getElementById('search');
      if (searchEl) new MutationObserver(nameInput).observe(searchEl, { childList: true, subtree: true });
      requestAnimationFrame(nameInput);
    } catch {
      document.getElementById('search-fallback').hidden = false;
    }
  })();
</script>

<style is:global>
  /* Theme Pagefind's UI with the site tokens */
  #search {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-text: var(--color-ink);
    --pagefind-ui-background: var(--color-surface);
    --pagefind-ui-border: var(--color-line);
    --pagefind-ui-tag: var(--color-line);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius-chip);
    --pagefind-ui-font: var(--font-sans);
  }
  #search .pagefind-ui__result-title {
    font-family: var(--font-display);
    font-weight: 400;
  }
</style>
