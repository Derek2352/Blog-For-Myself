---
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import instrumentWoff2 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import plexMonoWoff2 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import '@fontsource/instrument-serif';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono';
import '@fontsource/ibm-plex-mono/500.css';
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import { isDraftPreviewBuild } from '@/lib/content';
import type { PatternName } from '@/lib/patterns';

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL for the Open Graph image (entry covers). */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Soft page texture (see src/lib/patterns.ts). Category pages pass their own. */
  pattern?: PatternName;
  hue?: number;
}

const {
  title,
  description = site.description,
  ogImage = new URL('/og/site.png', Astro.site).toString(),
  ogType = 'website',
  pattern = 'plus',
  hue = 35,
} = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — Portfolio & Log`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Preload the three critical faces so text paints in its real metrics (no swap shift). -->
    <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={instrumentWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={plexMonoWoff2} crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL('rss.xml', Astro.site)}
    />
    <meta name="color-scheme" content="light dark" />
    {/* Draft-preview deploys must never be indexed if the URL leaks */}
    {isDraftPreviewBuild && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={title ?? pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Soft page-to-page transitions (covers morph, tabs slide). -->
    <ClientRouter />

    <!-- Theme before first paint: stored choice wins, else system preference.
         Re-applied after every client-side swap (the router replaces <html>
         attributes), plus a .js flag that scroll-reveals key off. -->
    <script is:inline>
      (() => {
        const apply = () => {
          try {
            const stored = localStorage.getItem('theme');
            const dark = stored
              ? stored === 'dark'
              : matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.classList.toggle('dark', dark);
          } catch {}
          document.documentElement.classList.add('js');
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
  </head>
  <body class="flex min-h-full flex-col">
    <div
      class:list={['page-bg', 'patterned', `pat-${pattern}`]}
      style={`--hue: ${hue}`}
      aria-hidden="true"
    >
    </div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-ink"
    >
      Skip to content
    </a>
    {
      isDraftPreviewBuild && (
        <p class="rail border-b border-signal/50 bg-signal/15 px-4 py-1.5 text-center text-signal-text">
          preview build — drafts visible · not the public site
        </p>
      )
    }
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-reveal for [data-io-reveal] elements (timeline frames, period
      // reels). Reduced-motion or no-IO browsers just see everything.
      const revealAll = () =>
        document.querySelectorAll('[data-io-reveal]').forEach((el) => el.classList.add('io-in'));

      function setupReveals(): void {
        if (
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          !('IntersectionObserver' in window)
        ) {
          revealAll();
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('io-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        document
          .querySelectorAll('[data-io-reveal]:not(.io-in)')
          .forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', setupReveals);
    </script>
  </body>
</html>
