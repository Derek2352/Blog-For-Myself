---
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import instrumentWoff2 from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import plexMonoWoff2 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import '@fontsource/instrument-serif';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono';
import '@fontsource/ibm-plex-mono/500.css';
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SiteCat from '@/components/SiteCat.astro';
import WelcomeNote from '@/components/WelcomeNote.astro';
import { site } from '@/data/site';
import { isDraftPreviewBuild } from '@/lib/content';
import { A11Y_KEYS } from '@/lib/a11y-prefs';

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL for the Open Graph image (entry covers). */
  ogImage?: string;
  /** Alt text describing the OG image (accessibility for shared previews). */
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** Warm wash hue (see src/lib/wash.ts). Category pages pass their own. */
  hue?: number;
  /** Optional JSON-LD structured data — one object or several. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  ogImage = new URL('/og/site.png', Astro.site).toString(),
  ogImageAlt,
  ogType = 'website',
  hue = 32,
  schema,
} = Astro.props;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — Portfolio & Log`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Keyed to the theme we actually render, not the OS preference — light is
        the default now, so a media-keyed value would tint a phone's address bar
        dark above a light page. The script below keeps it in sync from
        --color-ground so the two hexes live in exactly one place. */}
    <meta name="theme-color" id="theme-color" content="#f9f4ea" />
    <!-- Preload the three critical faces so text paints in its real metrics (no swap shift). -->
    <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={instrumentWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={plexMonoWoff2} crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL('rss.xml', Astro.site)}
    />
    <meta name="color-scheme" content="light dark" />
    {/* Draft-preview deploys must never be indexed if the URL leaks */}
    {isDraftPreviewBuild && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={title ?? pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:alt" content={ogImageAlt ?? title ?? site.title} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={ogImageAlt ?? title ?? site.title} />}

    {
      schemas.map((s) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(s).replace(/</g, '\\u003c')}
        />
      ))
    }

    <!-- Soft page-to-page transitions (covers morph, tabs slide). -->
    <ClientRouter />

    <!-- Theme + accessibility mode before first paint: stored choices win.
         Re-applied after every client-side swap (the router replaces <html>
         attributes), plus a .js flag that scroll-reveals key off. -->
    <script is:inline define:vars={{ a11yKeys: A11Y_KEYS }}>
      (() => {
        // Mirrors src/lib/theme.ts (an is:inline script can't import). Reads the
        // live token so the two ground hexes live only in global.css.
        // This script runs *before* the stylesheet link in <head>, so on the
        // first pass the token is still empty — retry once styles have applied,
        // otherwise a visitor who chose dark gets a cream address bar.
        const syncThemeColor = () => {
          const ground = getComputedStyle(document.documentElement)
            .getPropertyValue('--color-ground')
            .trim();
          if (ground) {
            document.getElementById('theme-color')?.setAttribute('content', ground);
          } else {
            document.addEventListener('DOMContentLoaded', syncThemeColor, { once: true });
          }
        };
        const apply = () => {
          try {
            // Light is the default: dark is opt-in through the toggle, so a
            // visitor whose device is in dark mode still lands on the paper look
            // the site is built around. A missing key reads as light.
            const dark = localStorage.getItem('theme') === 'dark';
            document.documentElement.classList.toggle('dark', dark);
            for (const k of a11yKeys) {
              document.documentElement.classList.toggle('a11y-' + k, localStorage.getItem('a11y-' + k) === '1');
            }
          } catch {}
          document.documentElement.classList.add('js');
          syncThemeColor();
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    {
      /* Privacy-friendly analytics — only when a token is configured (site.ts). */
      site.analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${site.analyticsToken}"}`}
        />
      )
    }
  </head>
  <body class="flex min-h-full flex-col">
    <div
      class:list={['page-bg', 'wash']}
      style={`--hue: ${hue}`}
      aria-hidden="true"
    >
    </div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-ink"
    >
      Skip to content
    </a>
    {
      isDraftPreviewBuild && (
        <p class="rail border-b border-signal/50 bg-signal/15 px-4 py-1.5 text-center text-signal-text">
          preview build — drafts visible · not the public site
        </p>
      )
    }
    <Header />
    <!-- polite announcement of the new page after client-side navigation -->
    <p class="sr-only" aria-live="polite" data-route-announce></p>
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SiteCat />
    <WelcomeNote />

    <script>
      // Scroll-reveal for [data-io-reveal] elements (timeline frames, period
      // reels). Reduced-motion or no-IO browsers just see everything.
      const REVEAL_SEL = '[data-io-reveal], [data-io-stagger]';
      const revealAll = () =>
        document.querySelectorAll(REVEAL_SEL).forEach((el) => el.classList.add('io-in'));

      // Retire the previous page's observer on navigation: elements that never
      // scrolled into view stay observed, so without this each client-side
      // navigation left another observer alive holding detached nodes.
      let revealIo: IntersectionObserver | null = null;

      function setupReveals(): void {
        revealIo?.disconnect();
        revealIo = null;
        if (
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          !('IntersectionObserver' in window)
        ) {
          revealAll();
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('io-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        document
          .querySelectorAll(`${REVEAL_SEL}`)
          .forEach((el) => !el.classList.contains('io-in') && io.observe(el));
        revealIo = io;
      }
      // Blur-up: fade each image in once it has decoded.
      function setupBlurup(): void {
        document.querySelectorAll<HTMLImageElement>('.blurup img').forEach((img) => {
          if (img.complete) img.classList.add('loaded');
          else img.addEventListener('load', () => img.classList.add('loaded'), { once: true });
        });
      }
      document.addEventListener('astro:page-load', setupReveals);
      document.addEventListener('astro:page-load', setupBlurup);

      // After a client-side navigation, move focus to <main> and announce the
      // page title, so screen-reader users learn the page changed.
      document.addEventListener('astro:after-swap', () => {
        const main = document.getElementById('main');
        const announce = document.querySelector('[data-route-announce]');
        if (announce) announce.textContent = document.title.replace(/ — .*/, '');
        if (main) main.focus({ preventScroll: true });
      });
    </script>
  </body>
</html>
