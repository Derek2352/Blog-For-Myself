---
/**
 * Category tabs — derived entirely from src/data/categories.ts + content.
 * On hover-capable devices each tab expands into a flyout of that
 * category's entries (its "sub-tabs"), collapsing when the pointer leaves.
 * Keyboard users get the same via :focus-within. On touch devices the
 * flyout is disabled and tapping the tab just opens the category page.
 * Wraps on wide screens, scrolls horizontally on narrow ones.
 */
import { getNavTree, categoryHref, entryHref } from '@/lib/content';

const tabs = await getNavTree();
const path = Astro.url.pathname.replace(/\/?$/, '/');
---

<nav aria-label="Categories" class="tabbar" data-tabbar>
  {
    tabs.map((tab) => {
      const href = categoryHref(tab.slug);
      const active = path === href;
      const hasFlyout = tab.entries.length > 0 || tab.logCount > 0;
      const flyoutId = `flyout-${tab.slug}`;
      return (
        <div class="tab-group">
          <a
            href={href}
            aria-current={active ? 'page' : undefined}
            aria-describedby={hasFlyout ? flyoutId : undefined}
            class:list={[
              'relative block whitespace-nowrap px-3 py-2.5 text-sm transition-colors',
              active ? 'font-medium text-ink' : 'text-muted hover:text-ink',
            ]}
          >
            {tab.label}
            {active && (
              <span
                class="absolute inset-x-3 bottom-0 h-[2px] bg-accent"
                transition:name="active-tab"
                aria-hidden="true"
              />
            )}
          </a>
          {hasFlyout && (
            <div class="tab-flyout" id={flyoutId}>
              <div class="tab-flyout-inner">
                <a class="flyout-head" href={href}>
                  {tab.label} · all →
                </a>
                {tab.entries.length > 0 && (
                  <ul class="flyout-list">
                    {tab.entries.map((e) => (
                      <li>
                        <a href={entryHref(e)}>{e.data.title}</a>
                      </li>
                    ))}
                  </ul>
                )}
                {tab.entryCount > tab.entries.length && (
                  <a class="flyout-more" href={href}>
                    View all {tab.entryCount} entries →
                  </a>
                )}
                {tab.logCount > 0 && (
                  <a class="flyout-more" href={`${href}#monthly-log-h`}>
                    + {tab.logCount} monthly {tab.logCount === 1 ? 'log' : 'logs'} →
                  </a>
                )}
              </div>
            </div>
          )}
        </div>
      );
    })
  }
</nav>

<script>
  // Flip the flyout to the right edge when it would overflow the viewport.
  function setupFlyouts(): void {
    document.querySelectorAll<HTMLElement>('[data-tabbar] .tab-group').forEach((group) => {
      const flyout = group.querySelector<HTMLElement>('.tab-flyout');
      if (!flyout) return;
      const check = () => {
        flyout.classList.remove('flip');
        const rect = flyout.getBoundingClientRect();
        if (rect.right > window.innerWidth - 8) flyout.classList.add('flip');
      };
      group.addEventListener('pointerenter', check);
      group.addEventListener('focusin', check);
    });
  }
  document.addEventListener('astro:page-load', setupFlyouts);
</script>
