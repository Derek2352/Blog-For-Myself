---
/**
 * Click-to-play video for entries. The page ships only the cover as a
 * poster + a play button; the real player (YouTube / Vimeo / Bilibili
 * iframe, or a native <video> for direct files) loads on click. Keeps
 * pages fast and tracker-free until the visitor opts in.
 *
 * The URL resolver and the click-to-play swap moved to `src/lib/video.ts` so the Next build shares
 * them — and so the resolver is unit-testable, which matters because no entry has a video yet and
 * nothing else would exercise its branches.
 */
import { Image } from 'astro:assets';
import { resolvePlayer } from '@/lib/video';

interface Props {
  url: string;
  title: string;
  poster: ImageMetadata;
}

const { url, title, poster } = Astro.props;

const player = resolvePlayer(url);
---

{
  player.kind === 'link' ? (
    <p class="rail">
      <a href={player.src} target="_blank" rel="noopener">
        Watch the film ↗
      </a>
    </p>
  ) : (
    <div
      class="frame video-embed relative aspect-video overflow-hidden"
      data-video-kind={player.kind}
      data-video-src={player.src}
      data-video-title={title}
    >
      <Image
        src={poster}
        alt=""
        widths={[720, 1100, 1600]}
        sizes="(min-width: 1280px) 72rem, 94vw"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <button
        type="button"
        data-video-play
        class="group absolute inset-0 flex h-full w-full cursor-pointer items-center justify-center"
        aria-label={`Play video: ${title}`}
      >
        <span class="flex items-center gap-3 rounded-(--radius-chip) border border-line bg-ground/95 px-5 py-3 transition-colors group-hover:border-accent">
          <svg viewBox="0 0 24 24" class="size-5 fill-accent" aria-hidden="true">
            <path d="M8 5.5v13l11-6.5-11-6.5Z" />
          </svg>
          <span class="rail text-ink">Play film</span>
        </span>
      </button>
    </div>
  )
}

<script>
  import { playVideo } from '@/lib/video';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.video-embed').forEach((box) => {
      box.querySelector('[data-video-play]')?.addEventListener('click', () => playVideo(box));
    });
  });
</script>
