---
interface Props {
  kind: string;
}
const { kind } = Astro.props;
const label = kind.replace(/-/g, ' ');
---

<span class="rail inline-flex items-center gap-1.5 rounded-(--radius-chip) border border-line px-1.5 py-px">
  <span class="size-1.5 rounded-full bg-signal" aria-hidden="true"></span>{label}
</span>
