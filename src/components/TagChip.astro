---
import { tagHref } from '@/lib/content';

interface Props {
  tag: string;
}
const { tag } = Astro.props;
---

<a
  href={tagHref(tag)}
  class="rail inline-flex min-h-6 items-center rounded-(--radius-chip) border border-line px-2 py-0.5 transition-colors hover:border-accent hover:text-accent"
>
  #{tag}
</a>
