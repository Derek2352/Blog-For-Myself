---
/**
 * CatCard — GDD §2.2's card model: the whole game on a mini-board.
 *
 * **Why this exists.** 2.0→2.1's game plays across the whole page: claims are real DOM
 * furniture, so every move means scrolling to it. The 2.2 finding: *"the visitor has to go up
 * and down just to make a click."* The concept is good; playing shouldn't mean scrolling.
 * This component is the self-contained alternative — a collapsed cat icon in the bottom-right
 * corner that expands into a floating card with a mini-board of tiles.
 *
 * **What is here.** The complete game, ported onto the card's coordinate system. The boss,
 * the squad, treats, stances, moods, territory and dialogue all run here with the same pure
 * logic (`arena.ts`, `squad.ts`, `card.ts`, `cat-sfx.ts`, `cat-game.ts`) — what changed is
 * the surface: tiles instead of page furniture, card-relative coordinates, and a `CARD_SCALE`
 * (1/5) on every distance constant while every duration stays as measured (§2.2's table).
 *
 * **The page stays untouched.** The card is `position: fixed` chrome; it never touches
 * `html.cat-arena-on`, never scrolls, never captures window events, and it leaves the page's
 * DOM and layout alone. Class names are card-scoped (`.cat-card-*`, `.cat-tile-*`) so the
 * fourteen harnesses that assert on the page game see nothing new. The page-board game in
 * CatArena.astro keeps working until the migration drops it.
 *
 * **A11y.** The collapsed icon is a real `<button>` with `aria-expanded`; the card is a
 * `role="dialog"` labelled region; Escape closes and returns focus. The fight itself is
 * `aria-hidden` when it runs (the arena already is) — the game is decoration, not content.
 */
import {
  CAT_TAIL_D,
  CAT_BODY_D,
  CAT_HEAD_D,
  CAT_EAR_FAR_D,
  CAT_EAR_NEAR_D,
  CAT_LEGS,
  catLegD,
  CAT_EYE,
  CAT_PUPIL,
} from '@/lib/cat-art';
import { getNavTree } from '@/lib/content';
import { resolveWash } from '@/lib/wash';

const nav = await getNavTree();

// The tile pool — "generated from the site's content structure — section headings,
// navigation categories, or a curated list" (§2.2). Navigation categories ARE the site's
// structure; they are stable, meaningful, and never the page furniture the old game claimed.
// Fixed routes the site always has are appended so the pool clears the 10–12 tile floor on
// every page, including ones where the nav is short.
//
// **Each tile carries its category's hue.** Until 2.4 this mapped to `c.label` alone and threw
// the hue away at this line — so a board of eleven tiles rendered eleven identical grey boxes
// while the very data that distinguishes them sat one property away, already used to wash every
// other page on the site. Reviewed at 3×, the board read as a settings panel rather than a
// game, and that was why: one flat texture, no variety, nothing tying it to the portfolio it is
// supposedly made of. `resolveWash` is the site's own resolver — a declared hue wins, otherwise
// a stable hash of the slug picks from the warm band — so the fixed routes get sensible hues
// with no decision required, exactly as a brand-new tab would.
const FIXED_TILES = [
  { label: 'About', slug: 'about' },
  { label: 'Timeline', slug: 'timeline' },
  { label: 'Search', slug: 'search' },
  { label: 'Colophon', slug: 'colophon' },
];
type Tile = { label: string; hue: number };
const TILE_POOL: Tile[] = [
  ...nav.map((c) => ({ label: c.label, hue: resolveWash(c).hue })),
  ...FIXED_TILES.map((f) => ({ label: f.label, hue: resolveWash(f).hue })),
];
const POOL_JSON = JSON.stringify(TILE_POOL);
---

<div class="cat-card-root" data-cat-card data-pool={POOL_JSON} transition:persist="cat-card">
  <!-- Collapsed: the tappable cat in the corner. Same sprite shapes as the ambient cat (§0:
       nothing new is drawn), rendered small, with idle animation beats to signal interactivity. -->
  <button
    id="cat-card-toggle"
    class="cat-card-icon tap-safe"
    type="button"
    aria-expanded="false"
    aria-controls="cat-card-panel"
    aria-label="Open the cat card game"
  >
    <svg viewBox="0 0 64 40" class="cat-card-icon-svg" aria-hidden="true">
      {/* One drawing, three copies — see `src/lib/cat-art.ts`. This used to be the path data
          pasted in by hand, on the reasoning that a byte-for-byte copy of `#site-cat` was the
          fix for a copy that had drifted (it had dropped the legs and the head, so the cat was
          a floating loaf). Agreeing by hand is not a guarantee; it is a coincidence that had
          already failed once. Now they cannot drift. */}
      <g class="cat-card-tail"><path d={CAT_TAIL_D}></path></g>
      <g class="cat-card-legs">
        {CAT_LEGS.map((l) => <path d={catLegD(l.x, l.lean)} />)}
      </g>
      <path class="cat-card-body" d={CAT_BODY_D}></path>
      <g class="cat-card-head">
        <path class="cat-card-ear cat-card-ear-far" d={CAT_EAR_FAR_D}></path>
        <path class="cat-card-ear cat-card-ear-near" d={CAT_EAR_NEAR_D}></path>
        <path d={CAT_HEAD_D}></path>
        <g class="cat-card-eye">
          <ellipse cx={CAT_EYE.cx} cy={CAT_EYE.cy} rx={CAT_EYE.rx} ry={CAT_EYE.ry}></ellipse>
          <ellipse class="cat-card-pupil" cx={CAT_EYE.cx} cy={CAT_EYE.cy} rx={CAT_PUPIL.rx} ry={CAT_PUPIL.ry}></ellipse>
        </g>
      </g>
    </svg>
    <!-- Treats collected from browsing, shown on the collapsed icon: the ammo display
         (§2.2) and the "I have something worth playing for" cue in one. -->
    <span class="cat-card-badge" data-badge hidden aria-hidden="true">0</span>
  </button>

  <!-- Expanded: the floating card. Scales up from the icon position; no ink curtain — §14.6
       makes the curtain optional and the card's own transition is the simpler open/close. -->
  <section
    id="cat-card-panel"
    class="cat-card-panel"
    role="dialog"
    aria-modal="false"
    aria-label="Cat card game"
    hidden
  >
    <!-- Header: controls live inside the card (the HUD chips move here in the migration). -->
    <header class="cat-card-header">
      <span class="cat-card-title rail">cat card</span>
      <div class="cat-card-controls">
        <button
          id="cat-card-sound"
          class="cat-card-btn"
          type="button"
          aria-pressed="true"
        >
          <span class="cat-card-pip" aria-hidden="true"></span>
          <span>sound</span>
        </button>
        <button
          id="cat-card-mode"
          class="cat-card-btn"
          type="button"
          aria-pressed="false"
        >
          <span class="cat-card-pip" aria-hidden="true"></span>
          <span>play it yourself</span>
        </button>
        <button
          id="cat-card-close"
          class="cat-card-btn"
          type="button"
          aria-label="Close the cat card game"
        >
          <span aria-hidden="true">×</span>
        </button>
      </div>
    </header>

    <!-- Territory: the player's share of the board, so it grows as you win. Sits between the
         header and the board — directly above the thing it measures. -->
    <div class="cat-card-territory" aria-hidden="true">
      <div class="cat-card-territory-fill" data-territory></div>
    </div>

    <!-- The board: a mini-grid of tiles, plus the game layer (boss, kittens, treat, ribbon).
         The board element is the coordinate space — see the script's `boardCoords`. -->
    <div class="cat-card-board" data-board role="group" aria-label="Tile board">
      <!-- The boss, a small sprite in the same drawing as the icon (§0). -->
      <div class="cat-card-boss" data-boss aria-hidden="true">
        <svg viewBox="0 0 64 40" class="cat-card-boss-svg">
          <path class="cat-card-boss-tail" d={CAT_TAIL_D}></path>
          <g class="cat-card-legs">
            {CAT_LEGS.map((l) => <path d={catLegD(l.x, l.lean)} />)}
          </g>
          <path class="cat-card-boss-body" d={CAT_BODY_D}></path>
          {/* The head is a group so it can move as one. It was not, and `[data-phase='eat']
              .cat-card-boss-head` had been styling a class no element carried — the cat's dip
              to its treat has never once played. */}
          <g class="cat-card-boss-head">
            <path class="cat-card-boss-ear cat-card-boss-ear-far" d={CAT_EAR_FAR_D}></path>
            <path class="cat-card-boss-ear cat-card-boss-ear-near" d={CAT_EAR_NEAR_D}></path>
            <path d={CAT_HEAD_D}></path>
            <g class="cat-card-eye">
              <ellipse cx={CAT_EYE.cx} cy={CAT_EYE.cy} rx={CAT_EYE.rx} ry={CAT_EYE.ry}></ellipse>
              <ellipse class="cat-card-pupil" cx={CAT_EYE.cx} cy={CAT_EYE.cy} rx={CAT_PUPIL.rx} ry={CAT_PUPIL.ry}></ellipse>
            </g>
          </g>
        </svg>
      </div>
      <!-- Kittens appear here (cloned from the boss drawing, §0). -->
      <div class="cat-card-squad" data-squad aria-hidden="true"></div>
      <!-- A thrown treat. -->
      <div class="cat-card-treat" data-treat aria-hidden="true" hidden>
        <svg viewBox="0 0 24 24"><use href="#treat-fish"></use></svg>
      </div>
      <!-- The ribbon: a line inside the card, anchored above the boss. -->
      <div class="cat-card-ribbon" data-ribbon role="status" hidden></div>
    </div>

    <!-- Footer: the game's voice on its own line, then round and the treat ammo the visitor
         collected from browsing. Two rows because one row at 320px truncated the caption to
         an ellipsis — the caption is the only thing that says what just happened. -->
    <footer class="cat-card-footer rail">
      <span class="cat-card-caption" data-caption></span>
      <span class="cat-card-stats">
        <span data-round>round 1</span>
        <span class="cat-card-ammo" data-ammo title="Treats collected from browsing"></span>
      </span>
    </footer>
  </section>
</div>

<script>
  import { initCatCard } from '@/lib/cat-card';

  /* The engine moved to `src/lib/cat-card.ts` so the Next build runs the identical arena rather
     than a second copy of it — see that file's header. The card persists across navigation, so
     this runs once and its disposer is never called here; the Next component uses it as an effect
     cleanup. */
  let wired = false;
  document.addEventListener('astro:page-load', () => {
    if (wired) return;
    if (!document.querySelector('.cat-card-root')) return;
    wired = true;
    initCatCard();
  });
</script>
