---
/**
 * The hero ink — a wet-paper simulation, not a drawing of one.
 *
 * The engine moved to `src/lib/ink-wash.ts` when the Next build needed the same canvas: it was
 * ~750 lines of simulation and ~50 of Astro lifecycle wiring, and a second copy of a fluid
 * simulation is the last thing on this site that should exist twice — the two would drift, and
 * "the ink looks slightly different" is not something anybody can diff. What is left here is the
 * element, and the one line that says when to start.
 *
 * Starts `hidden`, and only the script reveals it. So a reader with reduced motion — or with JS
 * off — gets no canvas at all rather than an empty one.
 */
---

<canvas class="ink-wash" aria-hidden="true" hidden></canvas>

<script>
  import { startInkWash } from '@/lib/ink-wash';

  /* Torn down and restarted per navigation. The engine's listeners used to be registered at
     module scope, which was correct while a module script ran once per session — but the disposer
     makes the lifetime explicit, and an explicit lifetime is what let the same code serve a
     component that mounts and unmounts. */
  let dispose: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    dispose?.();
    dispose = startInkWash();
  });
  document.addEventListener('astro:before-swap', () => {
    dispose?.();
    dispose = null;
  });
</script>
