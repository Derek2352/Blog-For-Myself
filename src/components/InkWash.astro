---
/**
 * 飛白 — the brush stroke across the top of the hero.
 *
 * One calligraphic sweep that paints itself on when you arrive, leaves splatter
 * as the brush passes, and then keeps bleeding very slowly at the edges. The
 * cursor flicks its own droplets, which dry in about two seconds.
 *
 * All of the shape-making lives in src/lib/ink.ts; this file is plumbing.
 *
 * Starts `hidden`, and only the script reveals it. So a reader with reduced
 * motion — or with JS off — gets no canvas at all rather than an empty one.
 */
---

<canvas class="ink-wash" aria-hidden="true" hidden></canvas>

<script>
  import { motionReduced } from '@/lib/a11y-prefs';
  import {
    INK_PEAK_ALPHA,
    INK_SEED,
    STROKE_BOTTOM,
    STROKE_TOP,
    TRAIL_MS,
    bristles,
    creep,
    entrance,
    splatter,
    strokeSpine,
    trailAlpha,
    type Bristle,
    type Splat,
    type SpinePoint,
  } from '@/lib/ink';

  /**
   * Render at full size. The blooms this replaced rendered at 0.3× because the
   * upscale doubled as their blur; a brush stroke is defined by crisp torn edges
   * and hair-fine striations, so the same trick would erase the whole point.
   * Canvas antialiases strokes natively, so nothing reads as harsh.
   */
  const SCALE = 1;
  /** Ink creeps slowly; 60fps would buy nothing and cost battery. */
  const FRAME_MS = 1000 / 15;
  const SPINE_SAMPLES = 90;
  const BRISTLES = 42;
  const SPLATS = 90;
  /** Hard cap, so a fast scribble cannot grow the per-frame cost without limit. */
  const MAX_DABS = 22;
  /** Minimum travel between cursor splats, in pixels. */
  const DAB_GAP = 26;
  /** How far the outer hairs trail the centre, as a fraction of the path. */
  const TIP_ROUND = 0.03;
  /**
   * What the brush paints, before the difference blend inverts it.
   *
   * Warm rather than pure white on purpose: inverting a warm palette with pure
   * white leaves a cool cast, and #fffaf0 lands the cream ground almost exactly
   * on neutral black instead of blue-black.
   */
  const INK_SOURCE = '#fffaf0';

  interface Dab {
    x: number;
    y: number;
    r: number;
    born: number;
  }

  let canvas: HTMLCanvasElement | null = null;
  let view: CanvasRenderingContext2D | null = null;
  let buf: HTMLCanvasElement | null = null;
  let bufCtx: CanvasRenderingContext2D | null = null;
  let host: HTMLElement | null = null;
  let spine: SpinePoint[] = [];
  let hairs: Bristle[] = [];
  let splats: Splat[] = [];
  let dabs: Dab[] = [];
  let raf = 0;
  let last = 0;
  let onScreen = false;
  let lastDabX = 0;
  let lastDabY = 0;
  let io: IntersectionObserver | null = null;
  /** When the brush started travelling. 0 until the first painted frame. */
  let arrivedAt = 0;

  // Capability, not width: this is the correct question for "is there a real
  // cursor". A phone drag over the hero means "scroll", and painting with it
  // would draw on every swipe.
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');

  /**
   * Draw the brush.
   *
   * Each hair is walked along the spine and emitted as a run of subpaths,
   * broken wherever that hair ran dry. Those breaks are the white — nothing
   * here draws a striation, it just declines to draw the hair.
   *
   * `reach` is how far along the path the brush has travelled, which is what
   * makes the entrance a stroke being made rather than a shape fading up.
   */
  function drawBrush(ctx: CanvasRenderingContext2D, reach: number, now: number): void {
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    for (const hair of hairs) {
      let open = false;
      let runAlpha = 0;
      // The brush head is round, so its outer hairs trail its centre. Stopping
      // every hair at the same instant gave the travelling stroke a hard
      // vertical leading edge that read as a clipping mask; letting the edges
      // lag shapes a real tip, for the same reason the striations work — model
      // the brush and the look follows.
      const tip = reach - Math.abs(hair.offset) * TIP_ROUND;
      for (let i = 0; i < spine.length; i++) {
        const p = spine[i]!;
        const inkLeft = hair.breaks[i]!;
        // past this hair's tip, or it has no ink here
        if (p.t > tip || inkLeft <= 0) {
          if (open) {
            ctx.globalAlpha = runAlpha;
            ctx.stroke();
            open = false;
          }
          continue;
        }
        const off =
          (hair.offset + hair.wander[i]! + creep(p.t, now, INK_SEED)) * p.width;
        const x = p.x + p.nx * off;
        const y = p.y + p.ny * off;
        if (!open) {
          ctx.beginPath();
          ctx.moveTo(x, y);
          ctx.lineWidth = Math.max(
            0.5,
            ((p.width * 2) / hairs.length + 0.5) * hair.press[i]! * 1.6,
          );
          runAlpha = inkLeft;
          open = true;
        } else {
          ctx.lineTo(x, y);
          // a run takes the darkest ink it passed through
          if (inkLeft > runAlpha) runAlpha = inkLeft;
        }
      }
      if (open) {
        ctx.globalAlpha = runAlpha;
        ctx.stroke();
      }
    }
    ctx.globalAlpha = 1;
  }

  /**
   * Hard-edged droplet. No gradient — a soft dot beside a dry brush reads wrong.
   * Stretched along its flight, so a hard-thrown drop lands as a comma.
   */
  function drawSplat(
    ctx: CanvasRenderingContext2D,
    x: number,
    y: number,
    r: number,
    a: number,
    aspect = 1,
    angle = 0,
  ): void {
    if (a <= 0 || r <= 0) return;
    ctx.globalAlpha = a;
    ctx.beginPath();
    ctx.ellipse(x, y, r * aspect, r, angle, 0, Math.PI * 2);
    ctx.fill();
    ctx.globalAlpha = 1;
  }

  function draw(now: number): void {
    if (!bufCtx || !buf || !view || !canvas) return;
    // Anchored to the first painted frame rather than to mount, so arriving with
    // the hero already scrolled past does not spend the entrance unseen.
    if (!arrivedAt) arrivedAt = now;
    const { spread, soak } = entrance(now - arrivedAt);

    bufCtx.clearRect(0, 0, buf.width, buf.height);
    // Always white, in both themes. The canvas composites with
    // mix-blend-mode: difference, so white inverts whatever it lands on — paper
    // goes dark and the text inside the stroke goes pale. That is the whole
    // soak effect, and it means there is no light-mode/dark-mode ink colour to
    // keep in sync: inversion is correct in both by construction.
    bufCtx.strokeStyle = INK_SOURCE;
    bufCtx.fillStyle = INK_SOURCE;

    drawBrush(bufCtx, spread, now);
    for (const s of splats) {
      if (s.at <= spread) drawSplat(bufCtx, s.x, s.y, s.r, 1, s.aspect, s.angle);
    }

    // Cursor droplets are drawn after the stroke and aged out here, so the list
    // can never outlive the ink that justifies it.
    if (dabs.length) {
      dabs = dabs.filter((d) => now - d.born < TRAIL_MS);
      for (const d of dabs) drawSplat(bufCtx, d.x, d.y, d.r, trailAlpha(now - d.born));
    }

    // One place, and only one, decides how present this layer is on the page.
    view.clearRect(0, 0, canvas.width, canvas.height);
    view.globalAlpha = INK_PEAK_ALPHA * soak;
    view.drawImage(buf, 0, 0, canvas.width, canvas.height);
    view.globalAlpha = 1;
  }

  function frame(now: number): void {
    // The canvas is front-page-only, so it cannot use transition:persist and
    // must genuinely stop. This check cannot leak even if a teardown event is
    // ever missed.
    if (!canvas || !canvas.isConnected) {
      stop();
      return;
    }
    raf = requestAnimationFrame(frame);
    if (now - last < FRAME_MS) return;
    last = now;
    draw(now);
  }

  function start(): void {
    if (raf || !canvas) return;
    last = 0;
    raf = requestAnimationFrame(frame);
  }

  function stop(): void {
    if (!raf) return;
    cancelAnimationFrame(raf);
    raf = 0;
  }

  /** Paint only while the hero is actually on screen and the tab is in front. */
  function sync(): void {
    if (onScreen && !document.hidden) start();
    else stop();
  }

  function resize(): void {
    if (!canvas || !buf) return;
    const rect = canvas.getBoundingClientRect();
    const w = Math.max(1, Math.round(rect.width));
    const h = Math.max(1, Math.round(rect.height));
    // DPR is ignored on purpose: this sits behind text at a third opacity, so
    // retina pixels would cost real memory for nothing anyone can see.
    canvas.width = w;
    canvas.height = h;
    buf.width = Math.max(1, Math.round(w * SCALE));
    buf.height = Math.max(1, Math.round(h * SCALE));
    // Aim at the headline rather than at a fraction of the hero.
    //
    // The stroke wants to cross large display type, where an inverted word
    // still reads instantly. Fractions cannot express that across breakpoints:
    // the band that frames the tagline at 1280 lands squarely on the body
    // paragraph at 390, because the stacked hero is far taller while its
    // heading sits higher. So measure the h1 and straddle it; the fractions
    // remain only as a fallback if the markup ever changes.
    const heading = host?.querySelector<HTMLElement>('h1');
    let bandTop = buf.height * STROKE_TOP;
    let bandBottom = buf.height * STROKE_BOTTOM;
    if (heading) {
      const hr = heading.getBoundingClientRect();
      // 0.68 down the heading is its second line — the italic tagline, which is
      // the most striking thing on the page to soak.
      const centre = hr.top - rect.top + hr.height * 0.68;
      const half = Math.max(52, hr.height * 0.85);
      bandTop = centre - half;
      bandBottom = centre + half;
    }

    // Computed once, never per frame. Re-deriving the hair pattern each frame
    // would make the striations crawl like static instead of holding still
    // while only the wet edge moves.
    spine = strokeSpine(buf.width, buf.height, INK_SEED, SPINE_SAMPLES, bandTop, bandBottom);
    hairs = bristles(spine, BRISTLES, INK_SEED);
    splats = splatter(spine, SPLATS, INK_SEED, bandBottom);
    if (raf) draw(performance.now());
  }

  function onPointerMove(e: PointerEvent): void {
    if (!canvas || dabs.length >= MAX_DABS) return;
    const rect = canvas.getBoundingClientRect();
    if (!rect.width || !rect.height) return;
    const x = ((e.clientX - rect.left) / rect.width) * canvas.width * SCALE;
    const y = ((e.clientY - rect.top) / rect.height) * canvas.height * SCALE;
    if (x < 0 || y < 0 || x > canvas.width * SCALE || y > canvas.height * SCALE) return;
    if (Math.hypot(x - lastDabX, y - lastDabY) < DAB_GAP) return;
    lastDabX = x;
    lastDabY = y;
    // Scaled from the brush's own head, not from the viewport. Sizing these off
    // the canvas made them roughly five times the brush's splatter — blobs
    // beside fine mist, which read as two different media on one surface.
    // Deliberately a little larger than that mist, since a flick you cannot see
    // is not worth the listener.
    const scale = spine[0]?.width ?? 12;
    const u = Math.random();
    dabs.push({ x, y, r: scale * (0.08 + u * u * u * 0.5), born: performance.now() });
    // A droplet flicked while the loop is parked would otherwise sit unpainted.
    sync();
  }

  function mount(): void {
    if (canvas) return;
    const el = document.querySelector<HTMLCanvasElement>('canvas.ink-wash');
    if (!el) return;
    // The decision was "nothing renders at all" — not a frozen frame.
    if (motionReduced()) return;

    const ctx = el.getContext('2d');
    const b = document.createElement('canvas');
    const bctx = b.getContext('2d');
    if (!ctx || !bctx) return;

    canvas = el;
    view = ctx;
    buf = b;
    bufCtx = bctx;
    host = el.parentElement;
    el.hidden = false;

    resize();

    window.addEventListener('resize', resize, { passive: true });
    // The canvas is pointer-events:none, so the hero section carries the
    // listener. Passive — flicking ink must never interfere with scrolling.
    if (finePointer.matches && host) {
      host.addEventListener('pointermove', onPointerMove, { passive: true });
    }

    io = new IntersectionObserver(
      (entries) => {
        onScreen = entries.some((entry) => entry.isIntersecting);
        sync();
      },
      { threshold: 0 },
    );
    io.observe(host ?? el);
  }

  function unmount(): void {
    stop();
    io?.disconnect();
    io = null;
    window.removeEventListener('resize', resize);
    host?.removeEventListener('pointermove', onPointerMove);
    if (canvas) canvas.hidden = true;
    canvas = null;
    view = null;
    buf = null;
    bufCtx = null;
    host = null;
    spine = [];
    hairs = [];
    splats = [];
    dabs = [];
    onScreen = false;
    // Landing on the page again should look like landing on it, so the brush
    // travels again rather than snapping back to a finished stroke.
    arrivedAt = 0;
  }

  /* ---- wiring. Registered once at module scope: with the view transitions
     router these listeners outlive every navigation, and re-registering them
     per page-load is how this codebase has leaked handlers before. ---- */

  document.addEventListener('astro:page-load', () => {
    // Deferred start: the hero photograph is fetchpriority="high" and is the LCP
    // element, so the ink waits until the page has finished loading rather than
    // competing with it. On a client-side navigation this is already complete.
    if (document.readyState === 'complete') mount();
    else window.addEventListener('load', mount, { once: true });
  });

  document.addEventListener('astro:before-swap', unmount);

  document.addEventListener('visibilitychange', sync);

  finePointer.addEventListener('change', () => {
    if (!host) return;
    host.removeEventListener('pointermove', onPointerMove);
    if (finePointer.matches) host.addEventListener('pointermove', onPointerMove, { passive: true });
  });

  // Both halves of motionReduced() can change while the page is open: the OS
  // setting, and the site's own "Reduce motion" toggle (an <html> class). The
  // same observer catches the theme class, which is when the ink colour flips.
  matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', syncMotion);
  new MutationObserver(syncMotion).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class'],
  });

  function syncMotion(): void {
    if (motionReduced()) unmount();
    else if (document.querySelector('canvas.ink-wash')) mount();
    // No theme colour to resync: the difference blend inverts whatever is
    // behind it, so dark mode is handled without this knowing about it.
    if (canvas && !raf) draw(performance.now());
  }
</script>
