---
/**
 * Reading progress bar + back-to-top button for long detail pages.
 * Progress reflects how far through the article you are; the button
 * appears past the first screen. Both are motion-safe and reset on
 * client-side navigation.
 */
---

<div class="reading-progress" data-progress aria-hidden="true"></div>
<button type="button" class="to-top" data-to-top aria-label="Back to top">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7"></path>
  </svg>
</button>

<script>
  // The scroll listener lives on `document`, which survives client-side
  // navigation, so it is registered ONCE for the session. `bar`/`btn` are
  // refreshed on every page-load (they only exist on entry pages); when they
  // are null the handler no-ops. Binding it inside the page-load callback
  // instead would stack a fresh listener on every navigation.
  let bar: HTMLElement | null = null;
  let btn: HTMLButtonElement | null = null;

  const reduceMotion = () =>
    matchMedia('(prefers-reduced-motion: reduce)').matches ||
    document.documentElement.classList.contains('a11y-motion');

  function onScroll(): void {
    if (!bar || !btn) return;
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    const pct = max > 0 ? Math.min(1, doc.scrollTop / max) : 0;
    bar.style.width = (pct * 100).toFixed(1) + '%';
    btn.classList.toggle('show', doc.scrollTop > doc.clientHeight * 0.6);
  }
  document.addEventListener('scroll', onScroll, { passive: true });

  document.addEventListener('astro:page-load', () => {
    bar = document.querySelector<HTMLElement>('[data-progress]');
    btn = document.querySelector<HTMLButtonElement>('[data-to-top]');
    if (btn) {
      btn.onclick = () => window.scrollTo({ top: 0, behavior: reduceMotion() ? 'auto' : 'smooth' });
    }
    onScroll();
  });
</script>
