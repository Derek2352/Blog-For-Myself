---
/**
 * First-visit welcome note. Shows once ever (localStorage), a beat after
 * the page paints — a note left on the desk, not a gate. Native <dialog>
 * gives a real focus trap, Esc-to-close, and backdrop dismissal. The flag
 * is set the moment it opens, so nobody is ever nagged twice.
 */
import { site } from '@/data/site';
---

<dialog id="welcome-note" class="welcome" aria-labelledby="welcome-h">
  <p class="kicker">hello · first visit</p>
  <h2 id="welcome-h" class="mt-2 font-display text-3xl leading-tight">Hi — welcome in.</h2>
  <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">
    This is the director’s cut of my CV: the projects and trips in full — what each one
    was, what I did, what it taught me, how it felt — plus the small monthly things that
    never fit on a page. Have a wander; the reflections are the good part.
  </p>
  <div class="mt-5 flex flex-wrap gap-3">
    <button
      type="button"
      data-welcome-close
      autofocus
      class="rounded-(--radius-chip) bg-accent px-4 py-2 text-sm font-medium text-accent-ink transition-opacity hover:opacity-90"
    >
      Come on in
    </button>
    <a
      href="/about/"
      data-welcome-close
      class="rounded-(--radius-chip) border border-line px-4 py-2 text-sm transition-colors hover:border-accent hover:text-accent"
    >
      More about me
    </a>
  </div>
  <p class="rail mt-5">ps · mind the cat along the bottom edge — it chases cursors</p>
  <p class="sr-only">{site.tagline}</p>
</dialog>

<style>
  .welcome {
    margin: auto;
    width: min(92vw, 27rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-ink);
    padding: 1.75rem;
    box-shadow: 0 24px 60px -24px rgb(30 20 10 / 0.35);
  }
  .welcome::backdrop {
    background: rgb(28 22 14 / 0.45);
  }
  @media (prefers-reduced-motion: no-preference) {
    .welcome[open] {
      animation: welcome-in 0.3s cubic-bezier(0.2, 0.6, 0.2, 1);
    }
    @keyframes welcome-in {
      from {
        opacity: 0;
        transform: translateY(10px) scale(0.985);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>

<script>
  const KEY = 'welcomed';
  let handledThisVisit = false;

  function maybeWelcome(): void {
    if (handledThisVisit) return;
    try {
      if (localStorage.getItem(KEY)) return;
    } catch {
      return; // no storage → showing every time would nag; skip instead
    }
    const dialog = document.getElementById('welcome-note');
    if (!(dialog instanceof HTMLDialogElement)) return;
    handledThisVisit = true;

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.querySelectorAll('[data-welcome-close]').forEach((el) => {
      el.addEventListener('click', () => dialog.close());
    });

    setTimeout(() => {
      try {
        localStorage.setItem(KEY, '1');
      } catch {}
      if (document.getElementById('welcome-note') === dialog) dialog.showModal();
    }, 700);
  }

  document.addEventListener('astro:page-load', maybeWelcome);
</script>
