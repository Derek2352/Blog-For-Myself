---
/**
 * Accessibility mode — a small popover of reader toggles (larger text,
 * high contrast, underline links, reduce motion). Choices persist to
 * localStorage and are applied to <html> before first paint (see Base).
 */
---

<div class="a11y" data-a11y>
  <button
    type="button"
    class="inline-flex size-8 items-center justify-center border border-line text-muted transition-colors hover:border-muted hover:text-ink"
    aria-label="Accessibility options"
    aria-expanded="false"
    aria-controls="a11y-menu"
    data-a11y-toggle
  >
    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="4" r="1.4" fill="currentColor" stroke="none"></circle>
      <path d="M4 8h16M12 8v8m0 0-3 4m3-4 3 4"></path>
    </svg>
  </button>
  <div class="a11y-menu" id="a11y-menu" role="group" aria-label="Accessibility" hidden>
    <p class="rail px-1 pb-1">Reading</p>
    <label><input type="checkbox" data-a11y-opt="large" /> Larger text</label>
    <label><input type="checkbox" data-a11y-opt="contrast" /> Higher contrast</label>
    <label><input type="checkbox" data-a11y-opt="underline" /> Underline links</label>
    <label><input type="checkbox" data-a11y-opt="motion" /> Reduce motion</label>
  </div>
</div>

<style>
  .a11y { position: relative; }
  .a11y-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 50;
    min-width: 12.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: 0 16px 40px -20px rgb(30 20 10 / 0.35);
    padding: 0.6rem;
  }
  .a11y-menu label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    padding: 0.35rem 0.4rem;
    border-radius: var(--radius-chip);
    cursor: pointer;
  }
  .a11y-menu label:hover { background: var(--color-ground); }
  .a11y-menu input { accent-color: var(--color-accent); width: 1rem; height: 1rem; }
</style>

<script>
  const A11Y_KEYS = ['large', 'contrast', 'underline', 'motion'] as const;

  function applyA11y(): void {
    for (const k of A11Y_KEYS) {
      let on = false;
      try { on = localStorage.getItem('a11y-' + k) === '1'; } catch {}
      document.documentElement.classList.toggle('a11y-' + k, on);
    }
  }

  // The popover lives in the header, which is re-rendered on every client-side
  // navigation, so these helpers re-query the *current* elements at call time.
  function openMenu(v: boolean): void {
    const toggle = document.querySelector<HTMLButtonElement>('[data-a11y] [data-a11y-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-a11y] .a11y-menu');
    if (!toggle || !menu) return;
    menu.hidden = !v;
    toggle.setAttribute('aria-expanded', String(v));
  }

  function setupA11y(): void {
    const root = document.querySelector<HTMLElement>('[data-a11y]');
    if (!root) return;
    const toggle = root.querySelector<HTMLButtonElement>('[data-a11y-toggle]');
    const menu = root.querySelector<HTMLElement>('.a11y-menu');
    if (!toggle || !menu) return;

    // reflect stored state into the checkboxes
    root.querySelectorAll<HTMLInputElement>('[data-a11y-opt]').forEach((box) => {
      const k = box.dataset.a11yOpt!;
      try { box.checked = localStorage.getItem('a11y-' + k) === '1'; } catch {}
      box.onchange = () => {
        try { localStorage.setItem('a11y-' + k, box.checked ? '1' : '0'); } catch {}
        document.documentElement.classList.toggle('a11y-' + k, box.checked);
      };
    });

    toggle.onclick = () => openMenu(menu.hidden);
  }

  // Outside-click and Escape close the popover. Both listen on `document`
  // (survives navigation) so they are registered ONCE — binding them inside
  // setupA11y would stack a new pair on every page load and leave old ones
  // firing against detached header nodes.
  document.addEventListener('click', (e) => {
    const root = document.querySelector<HTMLElement>('[data-a11y]');
    if (root && !root.contains(e.target as Node)) openMenu(false);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') openMenu(false); });

  document.addEventListener('astro:page-load', setupA11y);
  document.addEventListener('astro:after-swap', applyA11y);
</script>
