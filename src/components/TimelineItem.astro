---
/**
 * One frame on the /timeline reel: mono month + index code in the gutter,
 * title/role/summary in the body.
 */
import type { Entry } from '@/lib/content';
import { entryCode, entryHref } from '@/lib/content';
import { categoryBySlug } from '@/data/categories';
import { monthKey } from '@/lib/format';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const code = await entryCode(entry);
const category = categoryBySlug(entry.data.category);
---

<li
  class="grid grid-cols-[5.2rem_1fr] gap-4 border-b border-line py-5 sm:grid-cols-[6.5rem_1fr] sm:gap-6"
  data-io-reveal
>
  <div class="rail pt-1">
    <p>{monthKey(entry.data.date)}</p>
    <p class="mt-0.5 text-accent">{code}</p>
  </div>
  <div class="min-w-0">
    <h3 class="font-display text-xl leading-snug sm:text-2xl">
      <a href={entryHref(entry)} class="transition-colors hover:text-accent">
        {entry.data.title}
      </a>
    </h3>
    <p class="rail mt-1">
      {category?.label}
      {entry.data.role && ` · ${entry.data.role}`}
      {entry.data.draft && <span class="text-signal-text"> · draft</span>}
    </p>
    <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-muted">{entry.data.summary}</p>
  </div>
</li>
