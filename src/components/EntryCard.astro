---
/**
 * Card for a substantial entry. Two variants:
 *  - default: cover-led grid card (category pages, featured, related)
 *  - compact: horizontal row (monthly groupings, dense lists)
 * Alt text on the card cover is intentionally empty: the adjacent title is the
 * accessible name, so screen readers hear it once. Detail pages carry full alt.
 */
import { Image } from 'astro:assets';
import type { Entry } from '@/lib/content';
import { entryCode, entryHref } from '@/lib/content';
import { categoryBySlug } from '@/data/categories';
import { humanRange } from '@/lib/format';
import { orientation } from '@/lib/images';

interface Props {
  entry: Entry;
  compact?: boolean;
  /** Show the category label (useful in mixed, cross-category contexts). */
  showCategory?: boolean;
  /** Eager-load the cover (above-the-fold cards only). */
  eager?: boolean;
}

const { entry, compact = false, showCategory = false, eager = false } = Astro.props;
const code = await entryCode(entry);
const href = entryHref(entry);
const category = categoryBySlug(entry.data.category);
const range = humanRange(entry.data.date, entry.data.endDate);
// wide covers fill the card frame; tall/square ones sit matted on the surface
const coverFit = orientation(entry.data.cover) === 'wide' ? 'object-cover' : 'object-contain';
---

{
  compact ? (
    <article class="card panel group transition-colors hover:border-muted">
      <a href={href} class="flex items-center gap-4 p-3">
        <div
          class="card-cover h-16 w-24 shrink-0 overflow-hidden rounded-(--radius-chip) border border-line"
          transition:name={`cover-${entry.id}`}
        >
          <Image
            src={entry.data.cover}
            alt=""
            width={240}
            height={160}
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="min-w-0">
          <p class="rail">
            {range}
            {showCategory && category && ` · ${category.label}`}
            {entry.data.draft && <span class="text-signal-text"> · draft</span>}
            <span aria-hidden="true"> · </span>
            <span aria-hidden="true">{code}</span>
          </p>
          <h3 class="mt-0.5 font-display text-lg leading-snug transition-colors group-hover:text-accent">
            {entry.data.title}
          </h3>
          <p class="mt-0.5 truncate text-sm text-muted">{entry.data.summary}</p>
        </div>
      </a>
    </article>
  ) : (
    // min-w-0: the meta line below never wraps, so without it a grid track sized
    // `1fr` grows to fit the longest role and the card pushes past the viewport
    // on a phone.
    <article class="card lift group min-w-0">
      <a href={href} class="block">
        <div class="frame card-cover overflow-hidden" transition:name={`cover-${entry.id}`}>
          <Image
            src={entry.data.cover}
            alt=""
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
            class:list={['aspect-[16/10] w-full', coverFit]}
            loading={eager ? 'eager' : 'lazy'}
          />
        </div>
        {/* One line, always. This used to wrap, and a role long enough to push
            the code onto a second row dropped that card's title below its
            neighbours' — three cards side by side with three different title
            baselines. Now the role is the only shrinkable part: date and code
            hold their place, and the role gets whatever is left before it
            ellipsizes (the full string stays in the title attribute). */}
        <p class="rail mt-3 flex flex-nowrap items-baseline gap-x-2">
          <span class="shrink-0">{range}</span>
          {entry.data.role && (
            <>
              <span aria-hidden="true" class="shrink-0">
                ·
              </span>
              <span class="min-w-0 truncate" title={entry.data.role}>
                {entry.data.role}
              </span>
            </>
          )}
          {entry.data.draft && <span class="shrink-0 text-signal-text">· draft</span>}
          <span aria-hidden="true" class="shrink-0">
            ·
          </span>
          <span aria-hidden="true" class="shrink-0">
            {code}
          </span>
        </p>
        <h3 class="mt-1.5 font-display text-[1.35rem] leading-tight transition-colors group-hover:text-accent">
          {entry.data.title}
        </h3>
        <p class="mt-1.5 text-sm leading-relaxed text-muted">{entry.data.summary}</p>
        {showCategory && category && <p class="rail mt-2">{category.label}</p>}
      </a>
    </article>
  )
}
