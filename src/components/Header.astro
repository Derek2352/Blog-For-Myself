---
import ThemeToggle from './ThemeToggle.astro';
import A11yControls from './A11yControls.astro';
import TabBar from './TabBar.astro';
import { site } from '@/data/site';
import { getLogs } from '@/lib/content';

/**
 * Monthly earns its nav slot only once there are enough monthly logs for it to
 * show something Timeline doesn't. Below the threshold the two pages are nearly
 * the same list, which just makes a visitor click both to find out. The route
 * always exists; this only decides whether it's advertised, and it starts
 * appearing by itself as logs get written.
 */
const MONTHLY_NAV_MIN_LOGS = 4;
const showMonthly = (await getLogs()).length >= MONTHLY_NAV_MIN_LOGS;

const utility: { href: string; label: string; title?: string }[] = [
  ...(showMonthly ? [{ href: '/monthly/', label: 'Monthly' }] : []),
  { href: '/timeline/', label: 'Timeline' },
  { href: '/about/', label: 'About' },
  { href: '/search/', label: 'Search', title: 'Press / to search' },
];
const path = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="border-b border-line">
  <div class="wrap flex flex-wrap items-center gap-x-6 gap-y-2 pb-2 pt-4">
    <a href="/" class="group mr-auto no-underline">
      <span class="block font-display text-[1.55rem] leading-none group-hover:text-accent transition-colors">
        Derek Yung
      </span>
      <span class="rail mt-1 block">{site.mastheadNote}</span>
    </a>
    <nav aria-label="Site" class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm sm:gap-x-5">
      {
        utility.map((item) => (
          <a
            href={item.href}
            title={item.title}
            aria-current={path === item.href ? 'page' : undefined}
            class:list={[
              'py-1 transition-colors hover:text-accent',
              path === item.href ? 'text-accent' : 'text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      {/* The two icon buttons travel together so a narrow-screen wrap never
          strands one on its own line, and ml-auto keeps them at the right edge
          of whatever row they land on — the a11y popover is anchored right: 0
          to its button, so a left-aligned button would push it off-screen. */}
      <div class="ml-auto flex items-center gap-x-3">
        <A11yControls />
        <ThemeToggle />
      </div>
    </nav>
  </div>
  <div class="wrap">
    <div class="tabbar-wrap"><TabBar /></div>
  </div>
</header>

<p class="sr-only">{site.tagline}</p>

<script>
  import { shortcutsDisabled } from '@/lib/a11y-prefs';

  // "/" jumps to search from anywhere (unless you're typing somewhere)
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    // respect the a11y "Disable keyboard shortcuts" toggle (WCAG 2.1.4)
    if (shortcutsDisabled()) return;
    const target = e.target as HTMLElement | null;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target?.isContentEditable
    ) {
      return;
    }
    e.preventDefault();
    window.location.href = '/search/';
  });
</script>
