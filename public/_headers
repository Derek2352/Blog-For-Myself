# GENERATED by scripts/http-policy.mjs — run `npm run headers` after changing it.
#
# Read by Cloudflare (Workers and Pages) and Netlify; on Cloud Run scripts/serve-out.mjs applies
# the same policy instead. Every matching rule applies here and a repeated header is
# comma-joined, so no two rules name the same header — the catch-all leaves Cache-Control to the
# host, whose default (public, max-age=0, must-revalidate) is this site's rule anyway.

# content-hashed by Next — the URL changes when the bytes do
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# stable name, changes only when the generators are re-run
/content/*
  Cache-Control: public, max-age=3600
/og/*
  Cache-Control: public, max-age=3600
/assets/*
  Cache-Control: public, max-age=3600

# stable name, new bytes every deploy — always check (the host default, so not repeated here)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
