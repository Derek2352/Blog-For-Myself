{
  /* `tests/**` is deliberately NOT here, matching what `astro check` covered: src and scripts.
     Adding it surfaces seven pre-existing type errors in the suite — loose indexing, a couple of
     stale `@ts-expect-error` directives — none of which affect what the tests assert, and all of
     which are a separate piece of work. Widening the gate during a cutover would mix "the
     migration broke something" with "the tests were never checked", which is exactly the
     confusion this whole migration has been structured to avoid. */
  "include": [
    "src/**/*",
    "scripts/**/*",
    "next-env.d.ts",
    ".next/types/**/*",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "dist",
    "out",
    ".next",
    "node_modules"
  ],
  "compilerOptions": {
    /* These were inherited from `astro/tsconfigs/strict` until the Astro build was removed. Written
       out rather than swapped for a Next preset, because several of them are choices this codebase
       relies on — `verbatimModuleSyntax` and `isolatedModules` in particular, which is why every
       type-only import in `src/` is already written as one. */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  }
}
