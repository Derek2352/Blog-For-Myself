# build output — `npm run build` exports to out/ and finish-build.mjs renames it to dist/,
# so the published directory keeps the name every host config already has.
dist/
out/
.next/
next-env.d.ts
# tsc's incremental cache
tsconfig.tsbuildinfo

# dependencies
node_modules/

# logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# environment variables — never commit secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# media inbox — unsorted drops never enter git history
_inbox/*
!_inbox/README.md

# harness output — frame strips, report pages and page shots the harnesses render
# (scratchpad/hand-look.mjs, page-audit.mjs, plate-look.mjs, hud-corner.mjs, tab-edge.mjs).
# Regenerated on every run and measured in megabytes; the findings they produced live in the GDD.
# The 2.6.3 audit alone left ~50 shots in scratchpad/audit, every one of them true only of the
# build that produced it — evidence, read once, superseded by the next run.
scratchpad/out/
scratchpad/audit/
scratchpad/*.png

# Generated by scripts/stage-content-images.mjs — the originals live in src/content/.
public/content/
