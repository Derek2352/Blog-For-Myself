# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# environment variables — never commit secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# media inbox — unsorted drops never enter git history
_inbox/*
!_inbox/README.md

# harness output — frame strips and report pages the cat harnesses render (scratchpad/hand-look.mjs).
# Regenerated on every run and measured in megabytes; the findings they produced live in the GDD.
scratchpad/out/
